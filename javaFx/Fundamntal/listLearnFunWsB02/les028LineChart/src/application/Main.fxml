<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="551.0" prefWidth="585.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="application.MainController">
   <children>
      <LineChart fx:id="lineChart" title="LINE CHART">
        <xAxis>
          <CategoryAxis label="My X label" side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis label="My Y label" side="LEFT" />
        </yAxis>
      </LineChart>
      <Button fx:id="btnLoadChart" layoutX="267.0" layoutY="429.0" mnemonicParsing="false" onAction="#btn" text="Load Chart" />
   </children>
</AnchorPane>
