      </Button>
      <TextField fx:id="txtUsername" layoutX="51.0" layoutY="95.0" promptText="Username">
         <font>
            <Font size="18.0" />
         </font>
      </TextField>
      <PasswordField fx:id="txtPassword" layoutX="51.0" layoutY="159.0" promptText="Password">
         <font>
            <Font size="18.0" />
         </font>
      </PasswordField>
      <Label fx:id="lblStatus" layoutX="9.0" layoutY="30.0" prefHeight="25.0" prefWidth="277.0" text="Status" textFill="#bc1c1c">
